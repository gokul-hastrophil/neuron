POSTGRES_PASSWORD=replace-with-strong-random-password
DATABASE_URL=postgresql://neuron:replace-with-strong-random-password@db:5432/neuron
CONTROLLER_TOKEN=replace-with-long-random-secret
GITHUB_APP_ID=replace-with-app-id
GITHUB_INSTALLATION_ID=replace-with-installation-id
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_REPO=gokul-hastrophil/neuron
POLL_SECONDS=120
LEASE_SECONDS=900
