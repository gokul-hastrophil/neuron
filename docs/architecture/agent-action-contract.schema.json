{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neuron proposed tool action contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "tool",
    "arguments",
    "idempotency_key"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "tool": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{1,79}$"
    },
    "arguments": {
      "type": "object"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
